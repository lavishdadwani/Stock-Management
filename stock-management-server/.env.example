# Copy to .env
PORT=8000
NODE_ENV=development

MONGODB_URL=mongodb://127.0.0.1:27017/stock-management
JWT_SECRET=change_me_to_a_long_random_string

# Web app URL (CORS + email links)
FRONTEND_URL=http://localhost:5173

# Email (password reset, verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Optional: legacy Google Sheets integration
# TYPE=
# PROJECT_ID=
# PRIVATE_KEY_ID=
# PRIVATE_KEY=
# CLIENT_EMAIL=
# sheetID=
# sheetRange=
